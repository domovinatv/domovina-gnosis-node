# Node configuration. Copy to config/node.env (gitignored) and edit:
#   cp config/node.env.example config/node.env
# Every script reads config/versions.env, then this file.
# Secrets (webhook secret, validator passwords) never go here; see docs.

# --- Layout -----------------------------------------------------------------
# Everything the node needs lives under GNOSIS_ROOT, outside the user's home,
# so the launchd daemons don't depend on a logged-in user or on macOS privacy
# prompts. docs/01-architecture.md#layout
GNOSIS_ROOT=/opt/gnosis

# Hidden role account the daemons run as. Created by 10-host-setup.sh.
SERVICE_USER=_gnosis
SERVICE_UID=470

# --- Clients ----------------------------------------------------------------
# teku (default, prebuilt Java) or lighthouse (compiled from source).
# docs/02-decisions.md#adr-003
CL_CLIENT=teku

# Nethermind state backend for a FRESH sync.
#   false = classic patricia trie: the initial sync survives restarts.
#   true  = new flat DB (2.0 default): a restart during the initial snap sync
#           throws away all progress (Nethermind #13601).
# Has no effect on an existing database. Never flip it on a synced node.
NM_FLATDB=false

# Oldest block whose body and receipts Nethermind downloads (both ancient
# barriers). Empty = Nethermind's default for Gnosis (block 25349537, 2022).
# 42550000 = 2025-10-10, one year before the first sync on the i9. ADR-010.
# A fixed block, not a rolling window: history grows from here on.
NM_HISTORY_FROM_BLOCK=42550000

# Rolling history window: blocks and receipts older than this many epochs are
# deleted as new ones arrive. Careful: Nethermind 2.1.0 counts an epoch as 32
# blocks (Ethereum), not Gnosis' 16 slots. The cutoff is head - epochs * 32,
# so one "epoch" here is 32 x 5 s = 160 s and 198180 = 367 days (a full year
# plus margin). Measured on the i9 from the pruner log. Empty = keep everything
# from NM_HISTORY_FROM_BLOCK on. ADR-010.
NM_HISTORY_RETENTION_EPOCHS=198180

# Nethermind in-memory pruning cache, MB. 64 GB RAM leaves plenty of room.
NM_CACHE_MB=8192

# Peer targets. Without P2P port forwarding peers are outbound only (ADR-009).
NM_MAX_PEERS=50
CL_MAX_PEERS=80

# Java heap for Teku.
TEKU_HEAP=6g

# --- Ports (all RPC bound to 127.0.0.1) --------------------------------------
# Only the P2P ports (EL_P2P_PORT tcp+udp, CL_P2P_PORT tcp+udp, CL_QUIC_PORT udp)
# are forwarded on the router; same external and internal number. ADR-009.
# P2P ports are deliberately not the client defaults (30303/9000): those are
# often already taken on home/office routers (stale UPnP mappings, another
# node). See docs/10-network.md.
EL_HTTP_PORT=8545
EL_WS_PORT=8546
EL_ENGINE_PORT=8551
EL_P2P_PORT=30313
CL_HTTP_PORT=5052
CL_P2P_PORT=9010
CL_QUIC_PORT=9001
# Static public IPv4 of the site, if it has one. Teku then advertises exactly
# this IP and CL_P2P_PORT; without it discv5 can pick up a NAT-rewritten UDP
# port and peers cannot reach us. Leave empty on a dynamic IP. docs/10-network.md
P2P_ADVERTISED_IP=
EL_METRICS_PORT=6060
CL_METRICS_PORT=8008

CHECKPOINT_SYNC_URL=https://checkpoint.gnosischain.com

# --- Validator (leave VALIDATOR_ENABLED=false until docs/08 is done) ---------
VALIDATOR_ENABLED=false
# Address that receives transaction tips from proposed blocks. Without it tips
# are burned. Use an address you control (hardware wallet / Safe).
FEE_RECIPIENT=
GRAFFITI=Domovina

# --- RPC tunnel (Cloudflare Tunnel, docs/06, ADR-011) -------------------------
# Outbound-only tunnel to Cloudflare; RPC stays on 127.0.0.1, no port forward.
TUNNEL_ENABLED=false
# Node name from the catalogue (docs/11, ADR-012). Hostnames become
# <NODE_NAME>-rpc.<TUNNEL_ZONE> (HTTP) and <NODE_NAME>-ws.<TUNNEL_ZONE> (WebSocket).
NODE_NAME=
TUNNEL_ZONE=mpt.hr
# UUID from `cloudflared tunnel create`. Its credentials JSON goes to
# /opt/gnosis/secrets/cloudflared/<TUNNEL_ID>.json (never into git).
TUNNEL_ID=
TUNNEL_METRICS_PORT=20241

# --- Payment listener (docs/07) ---------------------------------------------
LISTENER_ENABLED=false
