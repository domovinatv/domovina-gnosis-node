# Pinned versions and SHA-256 checksums of everything this repo installs.
#
# This file is the only place versions live. To upgrade a component, change it
# here (version + checksum), commit, pull on the node, and run
# `sudo scripts/20-install.sh <component>` followed by `scripts/gnosisctl restart <service>`.
# docs/05-operations.md has the upgrade procedure; forks have hard deadlines.
#
# All artifacts are the macOS x86_64 (Intel) builds.
# Checksums verified 2026-10-01 (see docs/research/); Nethermind 2.1.0 and
# Teku 26.10.0 verified 2026-10-10 on the i9 (docs/2026-10-10-prvo-pokretanje-i9-disk.md).

# Execution client. GPG key AD12 7976 5093 C675 9CD8 A400 24A7 7461 6F1E 617E.
NETHERMIND_VERSION=2.1.0
NETHERMIND_COMMIT=b3e7e84c
NETHERMIND_SHA256=7e8beecfd46eb080173f12e9e2c6fa144235b0d7238137c2a14cd35b4792ebfe

# Consensus + validator client (Java, platform independent).
TEKU_VERSION=26.10.0
TEKU_SHA256=a770956982c6f0276b5b8ce05589e745d8d34117b6c320bccf2adbe9598227c5

# Java runtime for Teku (Teku 26.x needs Java 25+). Eclipse Temurin JRE.
TEMURIN_RELEASE=jdk-25.0.4.1+1
TEMURIN_FILE=OpenJDK25U-jre_x64_mac_hotspot_25.0.4.1_1.tar.gz
TEMURIN_SHA256=099cbc182af99ab454991a4230f0bdbf2b2ee3f61ce462d637aceaa12709380d

# Node.js LTS for the payment listener.
NODE_VERSION=v24.21.0
NODE_SHA256=1462cb3b3046b815cf8ea436d3da450ec1a9f11dac7e5a46b0ada5305d7e8097

# Cloudflare Tunnel connector (only needed when RPC is exposed, docs/06).
CLOUDFLARED_VERSION=2026.9.3
CLOUDFLARED_SHA256=d1155d0837487f261183b15c1eab6c4ebcad9dc49b94675f1524c3564cea3977

# Optional alternative consensus client, built from source (no Intel macOS
# binaries since v8.0.0). Only used when CL_CLIENT=lighthouse.
LIGHTHOUSE_VERSION=v8.2.3
LIGHTHOUSE_MIN_RUST=1.88.0

# .NET diagnostics for Nethermind (managed stacks, CPU traces). Admin tools,
# not part of the node: a .NET runtime (the tools need >= 8; Nethermind is
# self-contained and ships none) plus the dotnet-stack/dotnet-trace NuGet
# packages. Runtime checked against Microsoft's SHA-512, packages against
# NuGet's packageHash, 2026-10-11. `gnosisctl dotnet-stack|dotnet-trace`.
DOTNET_DIAG_RUNTIME_VERSION=10.0.12
DOTNET_DIAG_RUNTIME_SHA256=6c92a95f32ac75139b16c1de0bbea7df776dd710360ee3980239d9026cd53e71
DOTNET_DIAG_TOOLS_VERSION=10.0.750501
DOTNET_STACK_SHA256=cd35f399fe023f1793b528590a4d723a1f2f1d9b25696386d926a697bd24c0ca
DOTNET_TRACE_SHA256=ef17f25724a55f9685bfaf8506a778ea87c2b62783eca2ca73263226128b0d4e

# Validator key generation (run offline, docs/08-validator.md).
ETHSTAKER_DEPOSIT_CLI_VERSION=v1.3.0
ETHSTAKER_DEPOSIT_CLI_FILE=ethstaker_deposit-cli-d8016bc-darwin-amd64.tar.gz
