# Payment listener settings. Installed to /opt/gnosis/etc/listener.env
# (root:_gnosis 640) by scripts/20-install.sh and read with `node --env-file`.
# This copy in git holds no secrets; put the real values only on the node.

# Cloudflare Worker endpoint that receives signed events. Empty = log only.
WEBHOOK_URL=
# Shared HMAC key, >= 32 chars. Same value as the Worker secret.
# Generate: openssl rand -hex 32
WEBHOOK_SECRET=

# Blocks to wait before reporting (5 s each). Gnosis finalizes in ~2 epochs
# (~160 s):
#   0 = instant/realtime (reports as soon as Nethermind imports the block,
#       ~50-200 ms after block arrival via WebSocket newHeads)
#   2 = default compromise between speed (~10-15 s) and 1-2 block reorg safety
CONFIRMATIONS=2
POLL_MS=5000
# On restart, catch up at most this many blocks (720 ≈ 1 h).
MAX_BACKFILL=720

# Optional comma-separated ERC-20 contract allowlist. Empty = all ERC-20 tokens
# (legacy Monerium EURe v1 wrapper 0xcB444e... is always ignored because every
# v1 transfer also emits a canonical EURe v2 0x420CA0... Transfer log).
# Example for EURe-only:
# TOKEN_ALLOWLIST=0x420CA0f9B9b604cE0fd9C18EF134C705e5Fa3430

# RPC_HTTP_URL / RPC_WS_URL, STATE_FILE, WATCHLIST_FILE, LOG_FILE and PID_FILE are
# set by the launchd plist from config/node.env. `node --env-file` does not
# override variables that are already set, so don't put them here.
